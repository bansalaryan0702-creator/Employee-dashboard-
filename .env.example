# Ollama AI (runs locally, completely free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Python path for PDF/image processing
PYTHON_PATH=python

# Cloudinary (free 25GB) - get from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# APP_URL: The URL where this app is hosted (e.g. http://localhost:3000).
APP_URL="http://localhost:3000"

# EMAIL_USER: The Gmail address to send from (e.g. your email)
EMAIL_USER=
# EMAIL_APP_PASSWORD: App Password generated in Google Account settings
EMAIL_APP_PASSWORD=
# Printfield Profile
PRINTFIELD_EMAIL_USER=
PRINTFIELD_EMAIL_PASS=
# Whitefield Stationers Profile
WHITEFIELD_EMAIL_USER=
WHITEFIELD_EMAIL_PASS=
